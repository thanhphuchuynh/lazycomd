Output demo.gif
Set FontSize 13
Set Width 1080
Set Height 560
Set Padding 12
Set Framerate 15
Set Theme "Catppuccin Mocha"
Set TypingSpeed 70ms
Set Shell zsh

Env LAZYCOMD_ADDR "unix:///tmp/lzc-demo/state/lazycomd/lazycomd.sock"
Env PATH "/Users/tphuc/.local/bin:/opt/homebrew/bin:/usr/bin:/bin"

Hide
Type "cd /Users/tphuc/coding/lazycomd"
Enter
Show

Type "lazycomd"
Enter
Sleep 2.5s
Type "j"
Sleep 400ms
Type "s"
Sleep 1.2s
Type "3"
Sleep 1.8s
Type "2"
Sleep 800ms
Type "q"
Sleep 400ms
Type "lazycomd ls"
Enter
Sleep 2s
